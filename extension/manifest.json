{
    "manifest_version": 3,
    "name": "RoosterJS DevTools",
    "version": "0.1.0",
    "description": "Inspect the Content Model of RoosterJS editors on a page.",
    "minimum_chrome_version": "111",
    "devtools_page": "devtools.html",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["injected-agent.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["<all_urls>"],
            "js": ["content-script.js"],
            "run_at": "document_start",
            "world": "ISOLATED"
        }
    ],
    "host_permissions": ["<all_urls>"]
}
